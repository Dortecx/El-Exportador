{
  "name": "m3u-to-ytmusic",
  "version": "1.1.5",
  "description": "Convert M3U playlists to YouTube Music",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "m3u-to-ytmusic": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/cli.ts",
    "web": "tsx src/web/server.ts",
    "web:dist": "node dist/web/server.js",
    "build:portable:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-portable-win.ps1",
    "test": "vitest run",
    "test:watch": "vitest",
    "dry-run": "tsx src/cli.ts test/fixtures/extended.m3u --dry-run"
  },
  "keywords": [
    "m3u",
    "youtube",
    "youtube-music",
    "playlist",
    "converter"
  ],
  "license": "MIT",
  "dependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "chalk": "^5.3.0",
    "chrome-remote-interface": "^0.33.3",
    "commander": "^12.1.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.0",
    "google-auth-library": "^10.6.2",
    "googleapis": "^171.4.0",
    "jsonwebtoken": "^9.0.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-oauth-popup": "^1.0.5",
    "zustand": "^5.0.13",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
